{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"files": {
		"includes": [
			"**",
			"!dist",
			"!node_modules",
			"!bun.lock",
			"!evals/results",
			"!evals/canary",
			"!evals/decisions",
			"!evals/qualification/bundles",
			"!evals/qualification/patch-baselines"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["bench/**", "evals/**", "scripts/**", "tests/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
